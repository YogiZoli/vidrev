# Copy to .env for local development. Never commit .env.
# Names and domains are configuration, never hardcoded (DECISIONS D-28, SPEC section 4).

# --- Branding and hosts ---
PRODUCT_NAME=vidrev
# Brand site on GoHighLevel: landing, checkout, Privacy, Terms
BRAND_BASE_URL=https://brand.tld
# Optional: the page where creators manage or cancel their subscription (shown on /app/cancel)
# BILLING_PORTAL_URL=https://brand.tld/billing
# This app (dashboard, API, OAuth callbacks, Audit my channel)
APP_BASE_URL=https://app.brand.tld
# Fallback tracked link host for users without their own domain (D-33). Users' own domains are the default.
LINK_FALLBACK_BASE_URL=https://go.brand.tld

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/c2c_saas

# --- Security ---
# 32 random bytes, base64. Used for AES-256-GCM encryption of OAuth tokens, AI keys and integration configs.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Session and magic-link signing secret (proposal CC-06)
AUTH_SECRET=
# Bearer secret for the GoHighLevel provisioning webhook (docs/GHL-PROVISIONING.md); also verifies X-Signature when sent
PROVISIONING_SECRET=
# Owner emails (comma separated): /admin access, owner alerts, owner accounts seeded on the internal plan
ADMIN_EMAILS=

# --- Google / YouTube (app GCP project: customer replies) ---
# Scopes: openid email profile https://www.googleapis.com/auth/youtube.force-ssl
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Daily units for the app GCP project, shared by all customers (D-27, D-31)
QUOTA_DAILY_LIMIT=10000
# Secret used to verify PubSubHubbub (WebSub) push notifications for new uploads (proposal CC-06)
WEBSUB_SECRET=

# --- AI drafts (DECISIONS Q-13c) ---
# Owner platform Gemini key from its own billing-enabled GCP project (never the YouTube app project)
GEMINI_PLATFORM_API_KEY=
# Model names are configuration
AI_PLATFORM_MODEL=gemini-3.1-flash-lite

# --- Audit my channel (separate GCP project, different use case: D-34) ---
YT_API_KEY_AUDIT=
# Audit leads into the owner's GoHighLevel Sub-account (Private Integration key + location id)
OWNER_GHL_API_KEY=
OWNER_GHL_LOCATION_ID=
# Daily units of the audit project (its own quota, separate from the app project)
AUDIT_DAILY_LIMIT=10000
# Optional Cloudflare Turnstile on the public audit form (docs/SETUP-AUDIT.md); enforced only when both are set
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email ---
RESEND_API_KEY=
# Sender address on a verified Resend domain (proposal CC-06). Empty: Resend's test sender, which only delivers to the Resend account owner
EMAIL_FROM=

# --- Tracked links on the user's own domain: Cloudflare for SaaS, Custom Hostnames (D-33, proposal CC-03) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Hostname users point their CNAME to, e.g. customers.brand.tld (never change it after the first customer: it breaks their links)
CUSTOM_HOSTNAME_CNAME_TARGET=

# --- GoHighLevel OAuth (Private Marketplace app, docs/SETUP-GHL.md) ---
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Optional: space separated scopes, overrides the built-in list (no deploy needed if HighLevel renames one)
GHL_SCOPES=
# Optional: PEM of HighLevel's webhook signing key, only if HighLevel rotates it (write newlines as backslash-n)
GHL_WEBHOOK_PUBLIC_KEY=
# Optional: shared secret the Marketplace workflow action sends in the X-Vidrev-Key header (docs/SETUP-GHL.md)
GHL_ACTION_SECRET=
# Optional: owner GoHighLevel affiliate link, shown in onboarding to creators without GoHighLevel.
GHL_AFFILIATE_URL=

# Stripe needs no platform setting: creators paste their own restricted read-only key (DECISIONS P8-01).
# Beast Mode allowlist (DECISIONS A-25): comma separated account ids or emails; empty means nobody.
BEAST_MODE_ACCOUNTS=
# 29 day prospect delete (A-28): dry_run (default, lists only), on, off (emergency brake).
BEAST_DELETE=dry_run
