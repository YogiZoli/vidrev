{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "src/**",
      "scripts/**",
      "drizzle/**",
      "public/**",
      "package.json",
      "package-lock.json",
      "railway.json",
      "next.config.ts",
      "tsconfig.json",
      ".nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 25
  }
}
